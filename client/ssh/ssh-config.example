# =============================================================================
# Zero-Public-SSH Cross-Border Jump, VPC Hop & Reverse-Tunnel Config Example
# =============================================================================
# Why this matters:
#   1. Running raw 24/7 SSH or `autossh` directly to your Entry Relay VPS (:22 or
#      :2222) alongside :443 exposes plaintext `SSH-2.0-OpenSSH` banners and
#      keepalive timing from the same client IP, triggering multi-port blocking.
#   2. Exposing HAProxy TCP relay `:2222 -> Exit:22` on the Entry Relay VPS leaks
#      mismatched OpenSSH banners across Relay:22 and Relay:2222, letting global
#      scanners correlate your Entry Relay with your Fixed-Exit IP.
#   3. Auto-falling back to bare `:2222`/`:22` when `127.0.0.1:10808` blips leaks
#      raw cross-border SSH packets at the exact moment the proxy is degraded.
#
# Hardened Architecture (Zero Public SSH Exposure + Rotation-Proof):
#   - Exit VPS Cloud Firewall (`TCP 22` IPv4): allow ONLY `203.0.113.20/32`
#     (self-hairpin across 1:1 cloud NAT when Exit Xray dials `203.0.113.20:22`)
#     + `172.26.0.0/20` (VPC CIDR). Close `80`, `443`, and public IPv6.
#     * Why `203.0.113.20` instead of `127.0.0.1` / `172.26.2.20` / `*.internal`?
#       Standard client `v2rayN` / Xray routing rules send `geoip:private` and
#       `geosite:private` (which includes `domain:internal`) to `direct` locally!
#       Dialing `203.0.113.20:22` routes cleanly inside `127.0.0.1:10808` with
#       zero client Xray routing changes while remaining 100% closed to the public.
#   - Entry Relay Cloud Firewall: open ONLY `TCP 443` (`0.0.0.0/0` IPv4); restrict
#     `TCP 22` to `172.26.0.0/20` (VPC); close `80`, `2222`, and public IPv6.
#   - `Host vps-entry` jumps through `vps-jump` over the private VPC (`172.26.1.10`),
#     so rotating your Entry Relay's Static IP requires ZERO SSH or firewall edits!
#
# Replace the RFC 5737 / RFC 1918 placeholders below with your own:
#   198.51.100.10 -> Entry Relay VPS Static Public IP
#   172.26.1.10   -> Entry Relay VPS Private VPC IP
#   203.0.113.20  -> Fixed-Exit VPS Static Public IP
#   172.26.2.20   -> Fixed-Exit VPS Private VPC IP
#   172.26.0.0/20 -> Cloud VPC Subnet CIDR
# =============================================================================

# --- 1. macOS / Workstation Client (~/.ssh/config) ---
Host vps-jump vps-exit
    HostName 203.0.113.20
    Port 22
    User ubuntu
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    # Strict fail-closed via local REALITY SOCKS5 proxy (no bare public SSH fallback).
    # Note: macOS `/usr/bin/nc -G 8` sets TCP connect timeout only.
    ProxyCommand nc -X 5 -x 127.0.0.1:10808 -G 8 203.0.113.20 22
    ServerAliveInterval 30
    ServerAliveCountMax 4
    IPQoS none

Host vps-entry
    HostName 172.26.1.10
    Port 22
    HostKeyAlias 198.51.100.10
    User ubuntu
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    # Reaches Entry Relay over private VPC via Exit VPS (survives Entry IP rotation!)
    ProxyCommand ssh -W %h:%p -o BatchMode=yes vps-jump
    ServerAliveInterval 30
    ServerAliveCountMax 4
    IPQoS none

# Manual-only emergency aliases (require temporarily opening TCP 22 in your cloud
# console firewall first; NEVER referenced by automatic fallback)
Host vps-exit-emergency
    HostName 203.0.113.20
    Port 22
    User ubuntu
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ServerAliveInterval 30
    ServerAliveCountMax 4
    IPQoS none

Host vps-entry-emergency
    HostName 198.51.100.10
    Port 22
    User ubuntu
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    ServerAliveInterval 30
    ServerAliveCountMax 4
    IPQoS none

Host dev-box-tunnel
    HostName 127.0.0.1
    Port 6022
    User devuser
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    HostKeyAlias dev-box
    ProxyCommand ssh -W %h:%p -o BatchMode=yes vps-jump
    ServerAliveInterval 30
    ServerAliveCountMax 6
    IPQoS none
    Compression yes


# --- 2. Linux Dev Machine (~/.ssh/config for `autossh -M 0 -N -R 127.0.0.1:6022:127.0.0.1:22 tunnel-vps`) ---
Host tunnel-vps
    HostName 203.0.113.20
    Port 22
    User ubuntu
    IdentityFile ~/.ssh/id_ed25519_tunnel
    IdentitiesOnly yes
    ConnectTimeout 20
    # IMPORTANT (Ubuntu/Debian OpenBSD netcat pitfall):
    # Do NOT pass `-w <sec>` to `/bin/nc.openbsd` here! On Linux `nc.openbsd`, `-w`
    # acts as an IDLE DATA TIMEOUT (not just connect timeout) and will drop idle
    # `autossh -N -R` reverse tunnels every `<sec>` seconds. Let SSH `ConnectTimeout`
    # bound connection setup instead.
    ProxyCommand nc -X 5 -x 127.0.0.1:10808 203.0.113.20 22
    ServerAliveInterval 30
    ServerAliveCountMax 3
    TCPKeepAlive yes
    ExitOnForwardFailure yes
    StrictHostKeyChecking accept-new
    BatchMode yes
    IPQoS none
    Compression yes
